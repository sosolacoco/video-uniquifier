# --- Пользовательский контент: НИКОГДА не публиковать ---
input_videos/*
output_videos/*
audio_tracks/*
!input_videos/.gitkeep
!output_videos/.gitkeep
!audio_tracks/.gitkeep

# Архивы (могут содержать личный контент) — не публиковать
*.7z
*.zip
*.rar
*.tar
*.gz

# Любые видео/аудио на всякий случай (кроме PNG-оверлеев)
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.m4v
*.flv
*.wmv
*.mpg
*.mpeg
*.mp3
*.wav
*.aac
*.m4a
*.ogg
*.flac
*.opus

# Логи и локальные настройки
*.log
video_uniquifier_settings.json

# Python
__pycache__/
*.pyc
*.pyo

# PyInstaller
build/
dist/
*.spec

# Локальные бинарники ffmpeg для сборки exe
ffmpeg_bin/

# Временные папки проверок
_cmp/
_ver/
_in/
_out/
*.tmp
